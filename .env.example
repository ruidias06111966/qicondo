# Modelo de configuração. Copiar para `.env` e preencher.
# O `.env` real nunca é versionado.
#
# Em produção (Cloudflare Workers) as variáveis marcadas como SEGREDO entram por
# `wrangler secret put`, não por este ficheiro. Ver README, secção "Deploy".

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# As VITE_* são embutidas no bundle em tempo de build e chegam ao browser: só
# devem conter valores públicos. Painel: Project Settings → API.
VITE_SUPABASE_URL=https://<projeto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
VITE_SUPABASE_PROJECT_ID=<project-id>

# As mesmas, para o lado servidor.
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_PROJECT_ID=<project-id>

# SEGREDO. Ignora RLS por completo — nunca prefixar com VITE_ nem expor ao
# cliente. Usada pelas rotas de servidor e pelo processamento da fila de e-mail.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ---------------------------------------------------------------------------
# E-mail (Resend)
# ---------------------------------------------------------------------------
# SEGREDO. Painel da Resend → API Keys. O domínio remetente tem de estar
# verificado, caso contrário a API responde 403.
RESEND_API_KEY=re_<chave>

# SEGREDO. Gerado no Supabase em Authentication → Emails → Send Email Hook, no
# formato `v1,whsec_...`. É com ele que se valida a assinatura do webhook.
SEND_EMAIL_HOOK_SECRET=v1,whsec_<segredo>

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
# URL público, usado para montar os links enviados por e-mail.
SITE_URL=https://qicond.qidominios.com.br

# SEGREDO. Protege as rotas internas chamadas por agendamento
# (/api/public/wa-drain, /api/public/hooks/lembretes-cobranca, /api/email/preview).
# Qualquer string longa e aleatória serve: `openssl rand -hex 32`.
CRON_SECRET=<string-aleatoria>
